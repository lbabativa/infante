# ── Administración ────────────────────────────────────────────
# Contraseña del panel /admin (obligatoria en producción)
ADMIN_PASSWORD=cambia-esta-clave
# Secreto para firmar la sesión (cadena larga aleatoria)
SESSION_SECRET=pon-aqui-una-cadena-larga-y-aleatoria

# URL pública del portal (se usa en los enlaces de los mensajes)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Base de datos (MongoDB Atlas) ─────────────────────────────
# Atlas → Network Access debe permitir 0.0.0.0/0 para Vercel
MONGODB_URI=mongodb+srv://USUARIO:CLAVE@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=infante
# Solo si tu red local no resuelve registros SRV desde Node:
# MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1

# ── Automatización de mensajes ────────────────────────────────
# WhatsApp Cloud API (Meta). Sin estas variables los mensajes quedan
# en la bandeja "Mensajes" del admin con botón de envío 1-clic por WhatsApp.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# Correo vía Resend (opcional)
# RESEND_API_KEY=
# EMAIL_FROM="Infante Hair Stylist <citas@infante.com.co>"

# Protege /api/cron/recordatorios (Vercel Cron envía Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=otro-secreto

# ── Integraciones ─────────────────────────────────────────────
# NovaCall: recibe eventos de citas (booking.created, booking.cancelled, ...)
# NOVACALL_WEBHOOK_URL=
# Llave para que NovaCall (u otros sistemas) usen /api/v1/* en nombre del salón
# INTEGRATION_API_KEY=
